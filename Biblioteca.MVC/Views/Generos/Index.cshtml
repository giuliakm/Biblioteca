@model IEnumerable<Biblioteca.Modelos.Genero>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Libros)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                    @foreach (var libro in item.Libros)
                    {
                        @libro.Titulo
                        <br />
                    }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdGenero">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdGenero">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdGenero">Delete</a>
                    <a asp-action="Create" asp-route-id="@item.IdGenero">Create</a>
            </td>
        </tr>
}
    </tbody>
</table>
