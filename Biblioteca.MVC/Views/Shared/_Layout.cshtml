<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Biblioteca</title>

    <link rel="stylesheet" href="~/css/site.css" />

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <nav class="navbar">

        <a class="logo" asp-controller="Home" asp-action="Index">
            📚 Biblioteca
        </a>

        <div class="menu">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-controller="Libros" asp-action="Index">Libros</a>
            <a asp-controller="Autores" asp-action="Index">Autores</a>
            <a asp-controller="Generos" asp-action="Index">Géneros</a>
            <a asp-controller="Editoriales" asp-action="Index">Editoriales</a>
        </div>

    </nav>

    <main class="container">

        @RenderBody()

    </main>

    <footer>
        <p>📚 Sistema de Gestión de Biblioteca</p>
        <p>Proyecto académico - 2026</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
